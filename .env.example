# vrm — copy to .env and fill in. NEVER commit .env.
#
# Secrets are environment-only (spec §4). Non-secret settings live in config.yaml.
# Values are deliberately unquoted and single-line: `docker --env-file` and systemd's
# EnvironmentFile= each parse dotenv slightly differently (docker does not strip quotes),
# so a file that leans on quoting behaves differently across them.
#
# Real environment variables always win over this file — godotenv.Load() does not override
# what is already set. That is what makes it safe to leave in place outside development.

# --- Required. Startup fails fast and lists every missing one at once. ---

# Postgres for the assessments cache. Matches docker-compose.yml as committed, which
# publishes on host port 5433 to avoid colliding with an existing local Postgres on 5432.
DATABASE_URL=postgres://vrm:vrm@localhost:5433/vrm?sslmode=disable

# Anthropic Messages API — entity resolution (Phase 2) and checklist research (Phase 7).
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# BitSight API key (licensed). Phase 1.
BITSIGHT_API_KEY=

# --- Optional. When absent that source returns StatusSkipped, never an error. ---

# Raises NVD rate limits. Without it NVD throttles hard.
# https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# CVE Details paid API, Business/Enterprise tier (spec §6). Absent -> cvedetails skipped.
# NVD is the primary CVE source; this is strictly optional enrichment.
CVEDETAILS_API_KEY=
